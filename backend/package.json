{
  "name": "enquiry-hub-backend",
  "version": "0.0.1",
  "description": "Enquiry Hub - Backend API Platform",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit --coverage",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:regression": "jest --selectProjects regression --runInBand",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --selectProjects unit --watch",
    "test:smoke": "jest --selectProjects smoke --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@bull-board/api": "^5.20.0",
    "@bull-board/express": "^5.20.0",
    "@apollo/server": "^4.10.0",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-prometheus": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@prisma/client": "^5.18.0",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "axios": "^1.7.0",
    "dataloader": "^2.2.2",
    "graphql": "^16.8.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.0",
    "nestjs-pino": "^4.1.0",
    "opossum": "^8.1.0",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "fast-check": "^3.19.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "prisma": "^5.18.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "ws": "^8.21.0",
    "multer": "^2.2.0",
    "js-yaml": "^4.3.0",
    "lodash": "^4.17.24",
    "tar": "^7.5.19",
    "undici": "^6.27.0",
    "ip-address": "^10.3.1"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/main.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@common/(.*)$": "<rootDir>/src/common/$1",
      "^@modules/(.*)$": "<rootDir>/src/modules/$1",
      "^@database/(.*)$": "<rootDir>/src/database/$1",
      "^@queue/(.*)$": "<rootDir>/src/queue/$1",
      "^@cache/(.*)$": "<rootDir>/src/cache/$1",
      "^@observability/(.*)$": "<rootDir>/src/observability/$1"
    },
    "projects": [
      {
        "displayName": "unit",
        "testMatch": ["<rootDir>/test/unit/**/*.spec.ts"],
        "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }] },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1",
          "^@config/(.*)$": "<rootDir>/src/config/$1",
          "^@common/(.*)$": "<rootDir>/src/common/$1",
          "^@modules/(.*)$": "<rootDir>/src/modules/$1",
          "^@database/(.*)$": "<rootDir>/src/database/$1",
          "^@queue/(.*)$": "<rootDir>/src/queue/$1",
          "^@cache/(.*)$": "<rootDir>/src/cache/$1",
          "^@observability/(.*)$": "<rootDir>/src/observability/$1"
        }
      },
      {
        "displayName": "integration",
        "testMatch": ["<rootDir>/test/integration/**/*.spec.ts"],
        "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }] },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1",
          "^@config/(.*)$": "<rootDir>/src/config/$1",
          "^@common/(.*)$": "<rootDir>/src/common/$1",
          "^@modules/(.*)$": "<rootDir>/src/modules/$1",
          "^@database/(.*)$": "<rootDir>/src/database/$1",
          "^@queue/(.*)$": "<rootDir>/src/queue/$1",
          "^@cache/(.*)$": "<rootDir>/src/cache/$1",
          "^@observability/(.*)$": "<rootDir>/src/observability/$1"
        }
      },
      {
        "displayName": "regression",
        "testMatch": ["<rootDir>/test/regression/**/*.spec.ts"],
        "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }] },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1",
          "^@config/(.*)$": "<rootDir>/src/config/$1",
          "^@common/(.*)$": "<rootDir>/src/common/$1",
          "^@modules/(.*)$": "<rootDir>/src/modules/$1",
          "^@database/(.*)$": "<rootDir>/src/database/$1",
          "^@queue/(.*)$": "<rootDir>/src/queue/$1",
          "^@cache/(.*)$": "<rootDir>/src/cache/$1",
          "^@observability/(.*)$": "<rootDir>/src/observability/$1"
        }
      },
      {
        "displayName": "smoke",
        "testMatch": ["<rootDir>/test/smoke/**/*.spec.ts"],
        "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }] }
      }
    ]
  }
}
