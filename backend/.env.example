# =============================================================================
# Backend + Infrastructure Environment Variables
# Copy this file to .env and update values as needed
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/enquiry_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enquiry_dev

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_MAXMEMORY=256mb

# --- WordPress & MySQL ---
WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_NAME=wordpress
WORDPRESS_GRAPHQL_URL=http://wordpress:80/graphql
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin123
WP_ADMIN_EMAIL=admin@enquiry.dev
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE=Enquiry Platform Properties

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# --- API Documentation ---
SWAGGER_ENABLED=true

# --- Logging ---
LOG_LEVEL=debug

# --- Security ---
HMAC_SECRET=dev-hmac-secret-for-testing-only
API_KEYS=dev-api-key-1,dev-api-key-2
ADMIN_API_KEY=admin-secret-key

# --- SMTP ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev

# --- External Services ---
CRM_WEBHOOK_URL=http://localhost:9999/crm

# --- CORS ---
CORS_ORIGINS=http://localhost,http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true

# --- OpenTelemetry ---
OTEL_SERVICE_NAME=enquiry-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces
