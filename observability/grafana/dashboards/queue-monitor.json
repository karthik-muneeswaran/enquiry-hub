{
  "uid": "queue-monitor",
  "title": "Queue Monitor",
  "description": "Per-queue depth, throughput, and dead-letter queue monitoring",
  "tags": ["queues", "bullmq"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Queue Depth by State",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "queue_depth{state=\"waiting\"}",
          "legendFormat": "{{queue_name}} - Waiting"
        },
        {
          "expr": "queue_depth{state=\"active\"}",
          "legendFormat": "{{queue_name}} - Active"
        },
        {
          "expr": "queue_depth{state=\"completed\"}",
          "legendFormat": "{{queue_name}} - Completed"
        },
        {
          "expr": "queue_depth{state=\"failed\"}",
          "legendFormat": "{{queue_name}} - Failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 80 }
        }
      }
    },
    {
      "id": 2,
      "title": "Job Throughput (completed/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(queue_job_duration_seconds_count{status=\"completed\"}[5m])) by (queue_name) * 60",
          "legendFormat": "{{queue_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 3,
      "title": "Dead Letter Queue Depth",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "queue_depth{state=\"failed\"}",
          "legendFormat": "{{queue_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "title": "Average Job Processing Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(queue_job_duration_seconds_sum[5m])) by (queue_name) / sum(rate(queue_job_duration_seconds_count[5m])) by (queue_name)",
          "legendFormat": "{{queue_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Queue Wait Time (enqueue to processing)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(queue_job_duration_seconds_bucket{status=\"waiting\"}[5m])) by (le, queue_name))",
          "legendFormat": "{{queue_name}} p95 wait"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    }
  ]
}
